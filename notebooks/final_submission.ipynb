{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Final Submission Notebook\n",
    "\n",
    "This notebook aims to generate a robust final_submission.csv from the repo's datasets, cache, and artifacts, following the plan and diagnostics discussed. It loads the tabular, satellite, and CNN-embedding features, builds a solid cross-validated model, and outputs predictions for the test set."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.metrics import mean_absolute_error\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "import lightgbm as lgb\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Config: adapt as needed\n",
    "BASE = Path('.')\n",
    "DATASETS = BASE / 'datasets'\n",
    "CACHE = BASE / 'cache'\n",
    "ARTIFACTS = BASE / 'artifacts'\n",
    "TARGET_COL = 'construction_cost_per_m2_usd'\n",
    "GROUP_COL = 'location_id'  # adjust if your dataset uses 'location_id' or another ID\n",
    "" 
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def safe_load_csv(path: Path):\n",
    "    if not path.exists():\n",
    "        print(f'Warning: missing {path}')\n",
    "        return None\n",
    "    return pd.read_csv(path)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load candidate datasets if present\n",
    "train_tabular_path = DATASETS / 'train_tabular.csv'\n",
    "sat_train_path = DATASETS / 'sat_features_train.csv'\n",
    "sat_eval_path = DATASETS / 'sat_features_eval.csv'\n",
    "train_composite_path = DATASETS / 'train_composite.csv'\n",
    "eval_composite_path = DATASETS / 'evaluation_composite.csv'\n",
    "test_paths = list((DATASETS).glob('*test*.csv'))\n",
    "\n",
    "datasets = {\n",
    "    'train_tabular': safe_load_csv(train_tabular_path),\n",
    "    'sat_train': safe_load_csv(sat_train_path),\n",
    "    'sat_eval': safe_load_csv(sat_eval_path),\n",
    "    'train_composite': safe_load_csv(train_composite_path),\n",
    "    'eval_composite': safe_load_csv(eval_composite_path),\n",
    "}\n",
    "for k, df in list(datasets.items()):\n",
    "    print(k, '->', None if df is None else f'shape={df.shape}')\n",
    "\n",
    "test_df = None\n",
    "if test_paths:\n",
    "    test_df = safe_load_csv(Path(str(test_paths[0])))\n",
    "    print('Test loaded:', test_paths[0], 'shape=', test_df.shape)\n",
    ""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Merge strategy: join train_tabular with satellite features on common keys (location_id, quarter)\n",
    "def merge_features(main_df, sat_df, on_keys=['location_id', 'quarter']):\n",
    "    if main_df is None or sat_df is None:\n",
    "        return main_df\n",
    "    # Ensure keys exist\n",
    "    for k in on_keys:\n",
    "        if k not in main_df.columns or k not in sat_df.columns:\n",
    "            print(f'Warning: key {k} not in both frames')\n",
    "            return main_df\n",
    "    return main_df.merge(sat_df, on=on_keys, how='left')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build merged train data if possible\n",
    "train_df = datasets['train_tabular']\n",
    "if train_df is not None and datasets['sat_train'] is not None:\n",
    "    train_df = merge_features(train_df, datasets['sat_train'], ['location_id', 'quarter'])\n",
    "    print('Merged train shape:', train_df.shape)\n",
    "else:\n",
    "    print('No merge performed for train')\n",
    ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Attach CNN embeddings if present (cnn_emb_* columns)\n",
    "def get_embedding_cols(df):\n",
    "    return [c for c in df.columns if str(c).startswith('cnn_emb_')]\n",
    "\n",
    "def apply_pca_embeddings(train_df, test_df=None, n_components=128):\n",
    "    emb_cols = get_embedding_cols(train_df)\n",
    "    if not emb_cols:\n",
    "        print('No CNN embeddings found. Skipping PCA.')\n",
    "        return train_df, test_df, None\n",
    "    from sklearn.impute import SimpleImputer\n",
    "    from sklearn.preprocessing import StandardScaler\n",
    "    from sklearn.decomposition import PCA\n",
    "\n",
    "    X = train_df[emb_cols].values\n",
    "    imputer = SimpleImputer(strategy='median')\n",
    "    X = imputer.fit_transform(X)\n",
    "    scaler = StandardScaler()\n",
    "    X = scaler.fit_transform(X)\n",
    "    pca = PCA(n_components=n_components, random_state=42)\n",
    "    X_pca = pca.fit_transform(X)\n",
    "    # Append components as new features\n",
    "    for i in range(X_pca.shape[1]):\n",
    "        train_df[f'cnn_pca_{i}'] = X_pca[:, i]\n",
    "    if test_df is not None and emb_cols:\n",
    "        X2 = test_df[emb_cols].values\n",
    "        X2 = imputer.transform(X2)\n",
    "        X2 = scaler.transform(X2)\n",
    "        X2_pca = pca.transform(X2)\n",
    "        for i in range(X2_pca.shape[1]):\n",
    "            test_df[f'cnn_pca_{i}'] = X2_pca[:, i]\n",
    "    return train_df, test_df, pca\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply CNN embeddings PCA to train and (if available) test\n",
    "train_df, test_df, pca_model = apply_pca_embeddings(train_df, test_df, n_components=128)\n",
    "print('Post-embedding features:', [c for c in train_df.columns if c.startswith('cnn_pca_')])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare features and target for modeling\n",
    "TARGET = TARGET_COL\n",
    "if TARGET not in train_df.columns:\n",
    "    raise SystemExit('Target column not found in train_df')\n",
    "y = train_df[TARGET].astype(float).values\n",
    "X = train_df.drop(columns=[TARGET])\n",
    "# Drop identifiers if present\n",
    "for col in ['location_id', 'quarter', 'id', 'index']:\n",
    "    if col in X.columns:\n",
    "        X = X.drop(columns=[col])\n",
    "print('Feature columns:', X.columns.tolist())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simple imputation for numeric features\n",
    "from sklearn.impute import SimpleImputer\n",
    "imputer = SimpleImputer(strategy='median')\n",
    "X_i = imputer.fit_transform(X)\n",
    "X_df = pd.DataFrame(X_i, columns=X.columns)\n",
    "# Optional scaling\n",
    "scaler = StandardScaler()\n",
    "X_s = scaler.fit_transform(X_df)\n",
    "X_final = pd.DataFrame(X_s, columns=X.columns)\n",
    "print('Final feature shape:', X_final.shape)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cross-validation: GroupKFold by location_id\n",
    "if 'location_id' in train_df.columns:\n",
    "    groups = train_df['location_id'].values\n",
    "else:\n",
    "    groups = np.zeros(len(y))\n",
    "gkf = GroupKFold(n_splits=5)\n",
    "oof = np.zeros(len(y))\n",
    "models = []\n",
    "fold = 0\n",
    "for train_idx, val_idx in gkf.split(X_final, y, groups=groups):\n",
    "    X_tr, X_val = X_final.iloc[train_idx], X_final.iloc[val_idx]\n",
    "    y_tr, y_val = y[train_idx], y[val_idx]\n",
    "    lgbm = lgb.LGBMRegressor(\n",
    "        n_estimators=1000,\n",
    "        learning_rate=0.05,\n",
    "        num_leaves=31,\n",
    "        subsample=0.8,\n",
    "        colsample_bytree=0.8,\n",
    "        random_state=42,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    lgbm.fit(X_tr, y_tr, eval_set=[(X_val, y_val)], eval_metric='mae', verbose=False, early_stopping_rounds=50)\n",
    "    pred = lgbm.predict(X_val)\n",
    "    oof[val_idx] = pred\n",
    "    models.append(lgbm)\n",
    "    fold += 1\n",
    "\n",
    "cv_mae = mean_absolute_error(y, oof)\n",
    "print('CV MAE:', cv_mae)\n",
    "# Save oof predictions and feature importances for artifacts\n",
    "oof_df = pd.DataFrame({'location_id': train_df['location_id'], 'quarter': train_df['quarter'], 'true': y, 'pred': oof})\n",
    "oof_path = ARTIFACTS / 'oof_predictions.csv'\n",
    "oof_df.to_csv(oof_path, index=False)\n",
    "print('Saved OOF predictions to', oof_path)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train final model on full data and generate test predictions (if test is available)\n",
    "if test_df is not None and not test_df.empty:\n",
    "    # Align test with train: ensure same columns order\n",
    "    test_features = X_final.columns\n",
    "    test_cols = test_df.drop(columns=[TARGET] if TARGET in test_df.columns else [], errors='ignore').columns\n",
    "    # Build test data by applying the same imputer/scaler as training\n",
    "    try:\n",
    "        test_vals = test_df.drop(columns=[TARGET] if TARGET in test_df.columns else []).values\n",
    "        test_imputed = imputer.transform(test_vals)\n",
    "        test_scaled = scaler.transform(test_imputed)\n",
    "        test_final = pd.DataFrame(test_scaled, columns=test_vals[0].astype(str))\n",
    "        test_pred = models[-1].predict(test_final)\n",
    "        submission = pd.DataFrame({TARGET: test_pred})\n",
    "        final_sub_path = DATASETS / 'final_submission.csv'\n",
    "        submission.to_csv(final_sub_path, index=False)\n",
    "        print('Wrote final_submission.csv to', final_sub_path)\n",
    "    except Exception as e:\n",
    "        print('Error during test prediction:', e)\n",
    "else:\n",
    "    print('No test data found; final_submission.csv not generated.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Notes" ,
    "\n",
    "This notebook is designed to be resilient to missing data (no test, or no CNN embeddings). It focuses on creating a robust baseline with proper CV and a path to final submission. If you have coordinates / bounding boxes for sites, you can plug a site-local cropping strategy to improve CNN signal and re-run for potential gains."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Notebook finished. Check artifacts and datasets for final submission.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Appendix: How to adapt to your repo\n",
    "- Replace TARGET_COL with your actual target column name if different\n",
    "- Ensure dataset keys used for merges exist (location_id, quarter, country, etc.)\n",
    "- If you have dedicated test set, adjust paths to point to it and run final submission save\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Done')"
   ]
  }
